<ui:FluentWindow x:Class="Faqra.App.CommandBar.CommandBarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Command Bar"
                 Width="560"
                 MinWidth="560"
                 MaxWidth="560"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual">
    <!-- One field, one list (CommandBarView.swift:7-9): the search row, the body for the current mode,
         and a keyboard-hint footer. Nothing animates: a bar opened many times a day should just be there. -->
    <StackPanel>
        <Grid Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Search24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Border x:Name="ModeChip" Grid.Column="1" Visibility="Collapsed" CornerRadius="10" Padding="8,2"
                    Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock x:Name="ModeChipText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Border>
            <Grid Grid.Column="2">
                <TextBlock x:Name="Placeholder" FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="QueryBox" FontSize="16" BorderThickness="0" Background="Transparent" Padding="0"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                         SelectionBrush="{DynamicResource AccentFillColorDefaultBrush}" />
            </Grid>
        </Grid>
        <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <ScrollViewer x:Name="ListScroll" MaxHeight="452" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Body" Margin="8" />
        </ScrollViewer>
        <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Grid Margin="16,7,16,8">
            <TextBlock x:Name="FooterShortcut" FontSize="11" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="FooterHints" FontSize="11" HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
    </StackPanel>
</ui:FluentWindow>
