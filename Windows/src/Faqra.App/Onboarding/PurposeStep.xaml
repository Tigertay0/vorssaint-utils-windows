<UserControl x:Class="Faqra.App.Onboarding.PurposeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock x:Name="TitleText"
                   FontFamily="{StaticResource FaqraDisplayFont}"
                   FontSize="19"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,8,0,0" />
        <TextBlock x:Name="SubtitleText"
                   Style="{StaticResource Caption}"
                   TextAlignment="Center"
                   MaxWidth="380"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0" />

        <ItemsControl x:Name="PresetList" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="10"
                            Background="{Binding CardBackground}"
                            BorderBrush="{Binding CardBorder}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Content="{Binding ChooseText}"
                                       Tag="{Binding Preset}"
                                       Click="OnChoosePreset"
                                       Appearance="{Binding ButtonAppearance}"
                                       VerticalAlignment="Center"
                                       MinWidth="88" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="FeaturesHeader"
                   FontSize="11"
                   FontWeight="Bold"
                   Margin="2,16,0,8"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <ItemsControl x:Name="GroupList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="2,4,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4"
                                            Padding="11,8"
                                            CornerRadius="10"
                                            Opacity="{Binding RowOpacity}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="34" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      Tag="{Binding Feature}"
                                                      Click="OnToggleFeature" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="SkipText"
                   Style="{StaticResource Caption}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,8" />
    </StackPanel>
</UserControl>
