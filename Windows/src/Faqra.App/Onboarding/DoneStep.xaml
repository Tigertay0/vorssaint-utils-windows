<UserControl x:Class="Faqra.App.Onboarding.DoneStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border CornerRadius="10" Padding="24,36" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="GlyphImage" Width="112" Height="112" />
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource FaqraDisplayFont}"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock x:Name="BodyText"
                           Style="{StaticResource Caption}"
                           TextAlignment="Center"
                           MaxWidth="360"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintGlyph"
                   Text="&#xE8A1;"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="0,28,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="HintText"
                   Style="{StaticResource Caption}"
                   TextAlignment="Center"
                   MaxWidth="340"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
