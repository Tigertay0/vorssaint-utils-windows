<UserControl x:Class="Faqra.App.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />

        <ui:CardControl Margin="0,12,0,0" Icon="{ui:SymbolIcon Play24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock x:Name="LaunchAtLoginLabel" Style="{StaticResource Body}" />
                    <TextBlock x:Name="LaunchAtLoginError"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="LaunchAtLoginToggle" Click="OnLaunchAtLoginToggled" />
        </ui:CardControl>

        <ui:CardControl Margin="0,6,0,0" Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:CardControl.Header>
                <TextBlock x:Name="LanguageLabel" Style="{StaticResource Body}" />
            </ui:CardControl.Header>
            <ComboBox x:Name="LanguageBox" MinWidth="190" SelectionChanged="OnLanguageChosen" />
        </ui:CardControl>

        <ui:CardControl Margin="0,6,0,0" Icon="{ui:SymbolIcon PaintBrush24}">
            <ui:CardControl.Header>
                <TextBlock x:Name="AppearanceLabel" Style="{StaticResource Body}" />
            </ui:CardControl.Header>
            <ComboBox x:Name="AppearanceBox" MinWidth="190" SelectionChanged="OnAppearanceChosen" />
        </ui:CardControl>

        <TextBlock x:Name="TrayHeader" Style="{StaticResource SectionHeader}" />
        <ui:CardControl Icon="{ui:SymbolIcon Board24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock x:Name="ShowTrayIconLabel" Style="{StaticResource Body}" />
                    <TextBlock x:Name="ShowTrayIconHint" Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button x:Name="ShowTrayIconButton" Click="OnShowTrayIcon" Appearance="Secondary" />
        </ui:CardControl>
    </StackPanel>
</UserControl>
