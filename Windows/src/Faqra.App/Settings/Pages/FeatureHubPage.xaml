<UserControl x:Class="Faqra.App.Settings.Pages.FeatureHubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="IntroText" Style="{StaticResource Caption}" MaxWidth="560" HorizontalAlignment="Left" />

        <!-- Counter and the two bulk actions. -->
        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="CountText"
                       Style="{StaticResource Caption}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="InstallAllButton" Click="OnInstallAll" Appearance="Secondary" Margin="0,0,8,0" />
                <ui:Button x:Name="UninstallAllButton" Click="OnUninstallAll" Appearance="Secondary" />
            </StackPanel>
        </Grid>

        <!-- Restart banner: something that loaded this session is now uninstalled. -->
        <ui:CardControl x:Name="RestartBanner"
                        Margin="0,12,0,0"
                        Visibility="Collapsed"
                        Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <TextBlock x:Name="RestartText" Style="{StaticResource Body}" MaxWidth="460" HorizontalAlignment="Left" />
            </ui:CardControl.Header>
            <ui:Button x:Name="RestartButton" Click="OnRestart" Appearance="Primary" />
        </ui:CardControl>

        <TextBlock x:Name="PresetsHeader" Style="{StaticResource SectionHeader}" />
        <TextBlock x:Name="PresetsCaption" Style="{StaticResource Caption}" Margin="0,0,0,10" MaxWidth="560" HorizontalAlignment="Left" />
        <ItemsControl x:Name="PresetList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,0"
                            Padding="12"
                            MinHeight="104"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Description}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,8" />
                            <ui:Button Grid.Row="2"
                                       Content="{Binding ApplyText}"
                                       IsEnabled="{Binding IsAvailableOnWindows}"
                                       Tag="{Binding Preset}"
                                       Click="OnApplyPreset"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One section per feature group, rows in catalog order. -->
        <ItemsControl x:Name="GroupList" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding Note}"
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding NoteVisibility}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A plain bordered row rather than a CardControl: sixty-six of
                                         them are built at once, and the card's template was the
                                         slowest part of opening this page. -->
                                    <Border Margin="0,0,0,4"
                                            Padding="14,10"
                                            CornerRadius="6"
                                            Opacity="{Binding RowOpacity}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                      <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0"
                                                            Padding="5,1"
                                                            CornerRadius="7"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Visibility="{Binding BetaVisibility}">
                                                        <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <Border Margin="8,0,0,0"
                                                            Padding="6,1"
                                                            CornerRadius="7"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding EnergyLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="0,3,0,0"
                                                           MaxWidth="430"
                                                           HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding PendingNote}"
                                                           Style="{StaticResource Caption}"
                                                           Visibility="{Binding PendingVisibility}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding BlockedReason}"
                                                           Style="{StaticResource Caption}"
                                                           Visibility="{Binding BlockedVisibility}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Content="{Binding ButtonText}"
                                                   IsEnabled="{Binding CanFlip}"
                                                   Tag="{Binding}"
                                                   Click="OnToggleFeature"
                                                   MinWidth="88" />
                                      </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="FooterText"
                   Style="{StaticResource Caption}"
                   Margin="0,20,0,0"
                   MaxWidth="560"
                   HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
