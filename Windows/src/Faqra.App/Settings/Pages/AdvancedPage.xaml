<UserControl x:Class="Faqra.App.Settings.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />

        <TextBlock x:Name="BackupHeader" Style="{StaticResource SectionHeader}" />
        <TextBlock x:Name="BackupDescription" Style="{StaticResource Caption}" MaxWidth="560" HorizontalAlignment="Left" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button x:Name="ExportButton" Click="OnExport" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,8,0" />
            <ui:Button x:Name="ImportButton" Click="OnImport" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Style="{StaticResource Caption}"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <TextBlock x:Name="SettingsPathLabel"
                   Style="{StaticResource Caption}"
                   Margin="0,20,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock x:Name="SettingsPathText"
                   FontFamily="{StaticResource FaqraMonoFont}"
                   FontSize="11"
                   Margin="0,2,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</UserControl>
