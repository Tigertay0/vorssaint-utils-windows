<Window x:Class="Faqra.App.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FF1F1F1F"
        Foreground="White">
    <StackPanel Margin="28,28,28,24" HorizontalAlignment="Center">
        <Image x:Name="GlyphImage" Width="76" Height="76" Margin="0,0,0,14" />
        <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="#FFB0B0B0" />
            <Border x:Name="BetaBadge" Margin="6,0,0,0" Padding="5,1" CornerRadius="8" Background="#2EFF9F0A" Visibility="Collapsed">
                <TextBlock x:Name="BetaText" FontSize="9" FontWeight="Bold" Foreground="#FFFF9F0A" />
            </Border>
        </StackPanel>
        <TextBlock x:Name="DescriptionText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="#FFB0B0B0" Margin="0,14,0,0" />
        <Button x:Name="GitHubButton" Margin="0,14,0,0" Padding="12,4" HorizontalAlignment="Center" Click="OnViewOnGitHub" />
        <TextBlock x:Name="CopyrightText" FontSize="10" Foreground="#FF8A8A8A" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock x:Name="CreditText" FontSize="10" Foreground="#FF8A8A8A" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
</Window>
